// Cloudflare Workers static hosting for salvage.chapterists.com.
//
// The site is plain static files: `npm run build` writes them to dist/, and the
// Worker serves them as static assets with no code of its own. Deployed by
// .github/workflows/deploy-site.yml on pushes to main; see
// docs/deploying-the-site.md. Headers and caching live in public/_headers.
{
  "name": "salvage-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // /charts redirects to /charts/, matching Astro's trailingSlash: "always".
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    // Created on the first deploy, if chapterists.com is a zone in the same
    // Cloudflare account and salvage.chapterists.com has no DNS record yet.
    { "pattern": "salvage.chapterists.com", "custom_domain": true }
  ],
  // The workers.dev address would be a second copy of the site; keep it off.
  "workers_dev": false,
  "preview_urls": false
}
