---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = "Open-source tools and engine fixes that get more out of the hardware you already have, starting with Unreal Engine.",
} = Astro.props;
const fullTitle = title ? `${title} · Salvage` : "Salvage: your machine has more in it than you think";
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a1630" />
    <link rel="preload" href="/fonts/archivo/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem("salvage-theme");
        if (saved === "day" || saved === "night") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -4rem;
    background: var(--crane-yellow);
    color: var(--night-sea);
    padding: var(--s-2) var(--s-4);
    z-index: 10;
    font-weight: 700;
  }
  .skip:focus {
    top: var(--s-4);
  }
</style>
