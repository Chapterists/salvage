---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results and the sitemap (the 404 page). */
  noindex?: boolean;
}
const {
  title,
  description = "Chapterists' open-source toolbox: the tools we use to make our stories. Starting with Unreal Engine: lighter on low-RAM machines, better on a Mac.",
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Salvage` : "Salvage: Chapterists' open-source toolbox";
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link previews need an absolute URL. The source for the image is
// assets/brand/social-preview.html.
const socialImage = new URL("/social-preview.png", Astro.site);
const socialImageAlt =
  "The Salvage wordmark above the line \"The tools we use to make our stories,\" with a lifebuoy floating on the waterline.";
---
<!doctype html>
<html lang="en" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a1630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Salvage" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="preload" href="/fonts/archivo/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem("salvage-theme");
        if (saved === "day" || saved === "night") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -4rem;
    background: var(--crane-yellow);
    color: var(--night-sea);
    padding: var(--s-2) var(--s-4);
    z-index: 10;
    font-weight: 700;
  }
  .skip:focus {
    top: var(--s-4);
  }
</style>
