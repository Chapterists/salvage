---
// Every plugin in Unreal Engine 5.8.4, one mark each, laid out like rivets on a
// hull plate: what works on a Mac first, then what refit can patch or rebuild,
// then what needs porting. PSDImporter, the one the sounding rebuilt, is
// outlined. Counts come from lib/refit-sounding.ts.
import { verdicts, total, inGroup, REFIT_SOUNDING_HREF } from "../lib/refit-sounding";

interface Props {
  /** Link the caption to the sounding (off on the sounding itself). */
  link?: boolean;
}
const { link = true } = Astro.props;

const COLS = 42;
const CELL = 20;
const R = 7;
const color = { works: "var(--sea-glass)", refit: "var(--crane-yellow)", port: "var(--rescue-orange)" };

const cells: { x: number; y: number; v: (typeof verdicts)[number]; psd: boolean }[] = [];
let i = 0;
for (const v of verdicts) {
  for (let n = 0; n < v.count; n++, i++) {
    cells.push({
      x: (i % COLS) * CELL + CELL / 2,
      y: Math.floor(i / COLS) * CELL + CELL / 2,
      v,
      // PSDImporter: the first of the plugins that need porting.
      psd: v.key === "port" && n === 0,
    });
  }
}
const rows = Math.ceil(total / COLS);
const psd = cells.find((c) => c.psd)!;
const half = (x: number, y: number) => `M${x - R} ${y} A${R} ${R} 0 0 1 ${x + R} ${y} Z`;
---
<figure class="hold">
  <div class="head">
    <p><strong class="hull">{inGroup("works")}</strong> work on a Mac today.</p>
    <p><strong class="hull refit">{inGroup("refit")}</strong> need a patch, a rebuild, or both.</p>
    <p><strong class="hull port">{inGroup("port")}</strong> need porting.</p>
  </div>
  <svg
    viewBox={`0 0 ${COLS * CELL} ${rows * CELL}`}
    role="img"
    aria-label={`All ${total} plugins in Unreal Engine 5.8.4, one mark each: ${verdicts.map((v) => `${v.count} ${v.label.toLowerCase()}`).join(", ")}.`}
  >
    {cells.map((c) => {
      const fill = color[c.v.group];
      if (c.v.shape === "square") return <rect x={c.x - R} y={c.y - R} width={R * 2} height={R * 2} fill={fill} />;
      if (c.v.shape === "ring") return <circle cx={c.x} cy={c.y} r={R - 1} fill="none" stroke={fill} stroke-width="2" />;
      if (c.v.shape === "half")
        return (
          <>
            <circle cx={c.x} cy={c.y} r={R - 1} fill="none" stroke={fill} stroke-width="2" />
            <path d={half(c.x, c.y)} fill={fill} transform={`rotate(180 ${c.x} ${c.y})`} />
          </>
        );
      return <circle cx={c.x} cy={c.y} r={R} fill={fill} class:list={{ quiet: c.v.group === "works" }} />;
    })}
    <rect class="psd" x={psd.x - CELL / 2 + 1} y={psd.y - CELL / 2 + 1} width={CELL - 2} height={CELL - 2} />
  </svg>
  <ol class="legend">
    {verdicts.map((v) => (
      <li class={v.group}>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          {v.shape === "square" && <rect x="3" y="3" width="14" height="14" />}
          {v.shape === "dot" && <circle cx="10" cy="10" r="7" />}
          {v.shape === "ring" && <circle class="line" cx="10" cy="10" r="6" />}
          {v.shape === "half" && (
            <>
              <circle class="line" cx="10" cy="10" r="6" />
              <path d="M3 10 A7 7 0 0 0 17 10 Z" />
            </>
          )}
        </svg>
        <span class="n">{v.count}</span>
        <span>{v.label}</span>
      </li>
    ))}
    <li class="psd-key">
      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="1" y="1" width="18" height="18" /></svg>
      <span class="n"></span>
      <span>PSDImporter, the one this sounding rebuilt</span>
    </li>
  </ol>
  <figcaption>
    <strong>Measured.</strong> <code>salvage refit scan --engine-plugins</code> on Unreal Engine 5.8.4 for Mac read
    all {total} plugins under <code>Engine/Plugins</code> in about 7 seconds. None lacked source. A plugin that "works" here
    has Mac binaries and nothing in its way; refit doesn't load or run it.
    {link && <> <a href={REFIT_SOUNDING_HREF}>The whole sounding</a>.</>}
  </figcaption>
</figure>
<style>
  .hold {
    margin: var(--s-7) 0;
    background: var(--night-sea);
    color: var(--foam);
    padding: var(--s-6);
    max-width: 62rem;
    border-bottom: 6px solid var(--antifouling);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-bottom: var(--s-5);
  }
  .head p {
    margin: 0;
    color: var(--steel);
    font-size: var(--step-0);
  }
  .head strong {
    display: block;
    font-size: var(--step-4);
    line-height: 1;
    color: var(--sea-glass);
  }
  .head .refit {
    color: var(--crane-yellow);
  }
  .head .port {
    color: var(--rescue-orange);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .quiet {
    opacity: 0.7;
  }
  .psd {
    fill: none;
    stroke: var(--foam);
    stroke-width: 2;
  }
  .legend {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    columns: 2 18rem;
    column-gap: var(--s-6);
    font-size: var(--step--1);
  }
  .legend li {
    display: grid;
    grid-template-columns: 1rem 2.5rem minmax(0, 1fr);
    gap: var(--s-2);
    align-items: baseline;
    padding-block: 0.2rem;
    break-inside: avoid;
    color: var(--steel);
  }
  .legend svg {
    width: 0.9rem;
    align-self: center;
  }
  .legend .works svg {
    fill: var(--sea-glass);
    stroke: var(--sea-glass);
  }
  .legend .refit svg {
    fill: var(--crane-yellow);
    stroke: var(--crane-yellow);
  }
  .legend .port svg {
    fill: var(--rescue-orange);
  }
  .legend .line {
    fill: none;
    stroke-width: 2;
  }
  .legend .psd-key svg {
    fill: none;
    stroke: var(--foam);
    stroke-width: 2;
  }
  .legend .n {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--foam);
    text-align: right;
  }
  figcaption {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(244 241 234 / 0.16);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--steel);
    max-width: 46rem;
  }
  figcaption strong {
    color: var(--crane-yellow);
  }
  figcaption code {
    color: var(--foam);
  }
  figcaption a {
    color: var(--sea-glass);
  }
  @media (max-width: 700px) {
    .hold {
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--s-5) var(--gutter);
    }
    .head {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-3);
    }
    .head p {
      font-size: var(--step--1);
      line-height: 1.35;
    }
    .head strong {
      font-size: var(--step-3);
      margin-bottom: var(--s-1);
    }
  }
</style>
