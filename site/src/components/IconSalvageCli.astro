---
// Tool icon for the salvage command: a salvaged crate riding at the waterline,
// with a command prompt stenciled on its side. Same tile, waterline and colors
// as the workstream icons.
interface Props { class?: string; }
const { class: className } = Astro.props;
const planks = [48, 72];
---
<svg class:list={["app-icon", className]} viewBox="0 0 128 128" aria-hidden="true">
  <defs>
    <clipPath id="cli-tile"><rect width="128" height="128" rx="28" /></clipPath>
    <clipPath id="cli-above"><rect width="128" height="86" /></clipPath>
    <clipPath id="cli-below"><rect y="88" width="128" height="40" /></clipPath>
  </defs>
  <g clip-path="url(#cli-tile)">
    <rect width="128" height="128" fill="#1c3866" />
    <rect y="86" width="128" height="42" fill="#061024" />
    <g fill="#3ed6c1" opacity="0.55">
      <rect x="8" y="108" width="20" height="3" rx="1.5" />
      <rect x="96" y="104" width="24" height="3" rx="1.5" />
      <rect x="52" y="116" width="26" height="3" rx="1.5" />
    </g>
    <!-- the crate, tilted a little as it rides; the waterline stays level -->
    <g clip-path="url(#cli-above)">
      <g transform="rotate(-6 64 70)">
        <rect x="30" y="30" width="68" height="70" rx="2" fill="#ffc83d" />
        <g fill="#e0a92a">
          {planks.map((y) => <rect x="30" y={y} width="68" height="2.5" />)}
          <rect x="30" y="30" width="8" height="70" />
          <rect x="90" y="30" width="8" height="70" />
        </g>
        <rect x="30" y="30" width="68" height="8" fill="#ff5a1f" />
        <!-- stenciled prompt -->
        <path d="M45 50 L56 58 L45 66" fill="none" stroke="#0a1630" stroke-width="5.5" stroke-linecap="square" />
        <rect x="60" y="63" width="20" height="5.5" fill="#0a1630" />
      </g>
    </g>
    <g clip-path="url(#cli-below)">
      <g transform="rotate(-6 64 70)">
        <rect x="30" y="30" width="68" height="70" rx="2" fill="#c2362b" />
        <rect x="30" y="30" width="8" height="70" fill="#9e2a21" />
        <rect x="90" y="30" width="8" height="70" fill="#9e2a21" />
      </g>
    </g>
    <rect y="86" width="128" height="2" fill="#3ed6c1" opacity="0.7" />
  </g>
</svg>
<style>
  .app-icon {
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
