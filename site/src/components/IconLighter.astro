---
// Workstream icon for Lighter Unreal: a lighter (a barge) carrying a memory
// stick away, so the big ship can float in shallow water.
interface Props { class?: string; }
const { class: className } = Astro.props;
const contacts = Array.from({ length: 15 }, (_, i) => 33 + i * 4.2);
---
<svg class:list={["app-icon", className]} viewBox="0 0 128 128" aria-hidden="true">
  <defs>
    <clipPath id="lighter-tile"><rect width="128" height="128" rx="28" /></clipPath>
    <clipPath id="lighter-above"><rect width="128" height="80" /></clipPath>
    <clipPath id="lighter-below"><rect y="82" width="128" height="46" /></clipPath>
  </defs>
  <g clip-path="url(#lighter-tile)">
    <rect width="128" height="128" fill="#1c3866" />
    <rect y="80" width="128" height="48" fill="#061024" />
    <g fill="#3ed6c1" opacity="0.55">
      <rect x="10" y="104" width="22" height="3" rx="1.5" />
      <rect x="44" y="114" width="30" height="3" rx="1.5" />
      <rect x="88" y="104" width="26" height="3" rx="1.5" />
    </g>
    <!-- memory stick on deck -->
    <rect x="29" y="40" width="70" height="22" rx="2.5" fill="#3ed6c1" />
    <g fill="#0a1630">
      <rect x="34" y="44" width="12" height="9" rx="1" />
      <rect x="51" y="44" width="12" height="9" rx="1" />
      <rect x="68" y="44" width="12" height="9" rx="1" />
      <rect x="85" y="44" width="10" height="9" rx="1" />
    </g>
    <g fill="#ffc83d">{contacts.map((x) => <rect x={x} y="56" width="2.4" height="5" />)}</g>
    <rect x="62" y="56" width="5" height="6" fill="#3ed6c1" />
    <!-- the lighter -->
    <path d="M14 64 H114 L104 94 H26 Z" fill="#ff5a1f" clip-path="url(#lighter-above)" />
    <path d="M14 64 H114 L104 94 H26 Z" fill="#c2362b" clip-path="url(#lighter-below)" />
    <rect x="14" y="64" width="100" height="4" fill="#f4f1ea" />
  </g>
</svg>
