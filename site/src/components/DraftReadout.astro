---
// How a sounding will read: draft before and after, against a strip of draft
// marks. With no soundings yet it shows no waterline and no numbers.
const marks = [16, 14, 12, 10, 8, 6, 4, 2];
---
<figure class="readout">
  <svg class="strip" viewBox="0 0 120 330" aria-hidden="true">
    <rect x="0" y="0" width="120" height="330" fill="var(--hull-navy-hi)" />
    <rect x="0" y="244" width="120" height="86" fill="var(--antifouling)" />
    {marks.map((gb, i) => (
      <text x="28" y={40 + i * 38}>{gb}</text>
    ))}
    <text class="unit" x="72" y="40">GB</text>
  </svg>
  <dl>
    <div>
      <dt>Draft before</dt>
      <dd>Not measured</dd>
    </div>
    <div>
      <dt>Draft after</dt>
      <dd>Not measured</dd>
    </div>
    <div>
      <dt>Machine</dt>
      <dd>None yet</dd>
    </div>
  </dl>
  <figcaption>No soundings yet. When there are, the waterline goes on the strip and the numbers go here.</figcaption>
</figure>
<style>
  .readout {
    margin: 0 0 var(--s-7);
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 var(--s-6);
    max-width: 40rem;
    background: var(--night-sea);
    color: var(--foam);
    padding: var(--s-5);
    border-radius: 6px;
  }
  .strip {
    grid-row: 1 / 3;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .strip text {
    fill: var(--foam);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 24px;
  }
  .strip .unit {
    fill: var(--crane-yellow);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 13px;
  }
  dl {
    margin: 0;
    align-self: start;
  }
  dl > div {
    padding-block: var(--s-3);
    border-bottom: 1px solid rgb(244 241 234 / 0.14);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--steel);
  }
  dd {
    margin: 0.2rem 0 0;
    font-stretch: var(--stretch-hull);
    font-weight: 800;
    font-size: var(--step-2);
    color: var(--steel);
  }
  figcaption {
    align-self: end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--sea-glass);
    padding-top: var(--s-4);
  }
  @media (max-width: 520px) {
    .readout {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0 var(--s-4);
      padding: var(--s-4);
    }
    dd {
      font-size: var(--step-1);
    }
  }
</style>
