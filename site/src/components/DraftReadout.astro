---
// The latest sounding at a glance: draft before and after, against a strip of
// draft marks, with the water at each draft. Numbers come from
// lib/trim-sounding.ts.
import { stock, tier8, mb, gb, SOUNDING_HREF } from "../lib/trim-sounding";

const marks = [16, 14, 12, 10, 8, 6, 4, 2];
// The numerals' baselines sit on their marks: 16 at y = 40, 19 units per GB.
const y = (g: number) => 40 + (16 - g) * 19;
const before = y(stock.mem / 1024);
const after = y(tier8.mem / 1024);
---
<figure class="readout">
  <svg class="strip" viewBox="0 0 120 330" aria-hidden="true">
    <rect x="0" y="0" width="120" height="330" fill="var(--hull-navy-hi)" />
    <rect x="0" y={before} width="120" height={330 - before} fill="var(--antifouling)" />
    {marks.map((gb) => (
      <text x="28" y={y(gb)}>{gb}</text>
    ))}
    <text class="unit" x="72" y="40">GB</text>
    <rect class="sea" x="0" y={after} width="120" height={330 - after} />
    <path class="surface" d={`M0 ${after} H120`} />
    <path class="was" d={`M0 ${before} H120`} />
  </svg>
  <dl>
    <div>
      <dt>Draft before</dt>
      <dd>{gb(stock.mem)} GB <span>{mb(stock.mem)} MB, stock</span></dd>
    </div>
    <div>
      <dt>Draft after</dt>
      <dd>{gb(tier8.mem)} GB <span>{mb(tier8.mem)} MB, salvage trim's 8 GB tier</span></dd>
    </div>
    <div>
      <dt>Machine</dt>
      <dd class="small">Apple M4, 16 GB <span>Epic's Third Person template, Unreal Engine 5.8.4</span></dd>
    </div>
  </dl>
  <figcaption>
    The latest sounding: process memory 60 seconds in, median of 4 runs. The red above the water is what the 8 GB tier
    saved. <a href={SOUNDING_HREF}>Read it, with what it doesn't show yet</a>.
  </figcaption>
</figure>
<style>
  .readout {
    margin: 0 0 var(--s-7);
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 var(--s-6);
    max-width: 40rem;
    background: var(--night-sea);
    color: var(--foam);
    padding: var(--s-5);
    border-radius: 6px;
  }
  .strip {
    grid-row: 1 / 3;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .strip text {
    fill: var(--foam);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 24px;
  }
  .strip .unit {
    fill: var(--crane-yellow);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 13px;
  }
  dl {
    margin: 0;
    align-self: start;
  }
  dl > div {
    padding-block: var(--s-3);
    border-bottom: 1px solid rgb(244 241 234 / 0.14);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--steel);
  }
  dd {
    margin: 0.2rem 0 0;
    font-stretch: var(--stretch-hull);
    font-weight: 800;
    font-size: var(--step-2);
    color: var(--foam);
  }
  dd span {
    display: block;
    font-family: var(--font-mono);
    font-stretch: 100%;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--steel);
    margin-top: 0.15rem;
  }
  dd.small {
    font-size: var(--step-1);
  }
  .sea {
    fill: var(--deep-sea);
    opacity: 0.8;
  }
  .surface {
    stroke: var(--sea-glass);
    stroke-width: 2.5;
  }
  .was {
    stroke: var(--foam);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    opacity: 0.7;
  }
  figcaption {
    align-self: end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--steel);
    padding-top: var(--s-4);
  }
  figcaption a {
    color: var(--sea-glass);
  }
  @media (max-width: 520px) {
    .readout {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0 var(--s-4);
      padding: var(--s-4);
    }
    dd {
      font-size: var(--step-1);
    }
  }
</style>
