---
// Workstream icon for Unreal on Mac: a ship in drydock under a crane, out of
// the water where the work is easy to reach.
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<svg class:list={["app-icon", className]} viewBox="0 0 128 128" aria-hidden="true">
  <defs>
    <clipPath id="dock-tile"><rect width="128" height="128" rx="28" /></clipPath>
    <clipPath id="dock-topsides"><rect width="128" height="79" /></clipPath>
    <clipPath id="dock-bottom"><rect y="83" width="128" height="45" /></clipPath>
  </defs>
  <g clip-path="url(#dock-tile)">
    <rect width="128" height="128" fill="#1c3866" />
    <!-- quay and the dry basin -->
    <rect y="88" width="128" height="40" fill="#2b4a80" />
    <path d="M16 88 H112 L104 120 H24 Z" fill="#061024" />
    <g fill="#a9b4c8">
      <rect x="44" y="106" width="9" height="8" />
      <rect x="60" y="106" width="9" height="8" />
      <rect x="76" y="106" width="9" height="8" />
    </g>
    <!-- the ship, propped on keel blocks -->
    <path d="M22 54 L110 50 L100 106 H36 Z" fill="#f4f1ea" clip-path="url(#dock-topsides)" />
    <path d="M22 54 L110 50 L100 106 H36 Z" fill="#c2362b" clip-path="url(#dock-bottom)" />
    <rect x="22" y="50" width="88" height="5" fill="#0a1630" transform="rotate(-2.6 66 52)" />
    <!-- crane -->
    <g fill="#ffc83d">
      <rect x="6" y="14" width="8" height="74" />
      <rect x="6" y="14" width="86" height="7" />
      <path d="M14 21 L34 21 L14 41 Z" />
    </g>
    <rect x="77" y="21" width="2" height="18" fill="#f4f1ea" />
    <rect x="72" y="38" width="12" height="7" rx="1.5" fill="#ffc83d" />
  </g>
</svg>
