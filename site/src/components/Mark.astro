---
// The lifebuoy: a Rescue Orange ring with four Foam bands. --mark-edge draws an
// outline so the Foam bands hold their shape on light grounds.
interface Props { class?: string; title?: string; }
const { class: className, title } = Astro.props;
---
<svg class:list={["mark", className]} viewBox="0 0 100 100" role={title ? "img" : undefined} aria-label={title} aria-hidden={title ? undefined : "true"}>
  <circle cx="50" cy="50" r="35.25" fill="none" stroke="var(--rescue-orange)" stroke-width="23.5" />
  <path fill="var(--foam)" d="M91.5 72.07A47 47 0 0 1 72.07 91.5L61.03 70.75A23.5 23.5 0 0 0 70.75 61.03ZM27.93 91.5A47 47 0 0 1 8.5 72.07L29.25 61.03A23.5 23.5 0 0 0 38.97 70.75ZM8.5 27.93A47 47 0 0 1 27.93 8.5L38.97 29.25A23.5 23.5 0 0 0 29.25 38.97ZM72.07 8.5A47 47 0 0 1 91.5 27.93L70.75 38.97A23.5 23.5 0 0 0 61.03 29.25Z" />
  <circle cx="50" cy="50" r="47" fill="none" stroke="var(--mark-edge, transparent)" stroke-width="3" />
  <circle cx="50" cy="50" r="23.5" fill="none" stroke="var(--mark-edge, transparent)" stroke-width="3" />
</svg>
