---
import Page from "../../layouts/Page.astro";

const charts = [
  {
    href: "/charts/unreal-memory-on-16-gb/",
    title: "Where Unreal's memory goes on a 16 GB machine",
    tool: "UE 5.8 defaults",
    what: "The texture pool, Nanite, shadows, Lumen, render targets, audio, garbage collection and shader workers: what each one is, its default, and the setting behind it.",
  },
  {
    href: "/charts/salvage-doctor/",
    title: "Check a Mac for Unreal",
    tool: "salvage doctor",
    what: "Run 12 checks on Xcode, Metal, disk, caches, memory and the debugger, and read what they say.",
  },
  {
    href: "/charts/salvage-clangd/",
    title: "Write Unreal C++ in VS Code or Neovim",
    tool: "salvage clangd",
    what: "Set up clangd for an Unreal project on a Mac: completion, go-to-definition and live errors, without Xcode's indexer.",
  },
  {
    href: "/charts/salvage-lldb/",
    title: "Read Unreal types in the debugger",
    tool: "salvage lldb",
    what: "Make Xcode and LLDB show FString, TObjectPtr, TSharedPtr, FVector and more as values, and take it out again.",
  },
  {
    href: "/charts/salvage-soundings/",
    title: "See where a game's memory goes",
    tool: "salvage soundings",
    what: "Read a memreport or LLM CSV, see how a run sits against 8, 12 and 16 GB machines, and compare two runs.",
  },
  {
    href: "/charts/capturing-memory-runs/",
    title: "Capture memory runs you can compare",
    tool: "memreport and -llmcsv",
    what: "Take memory captures from a game so that two runs still mean something side by side.",
  },
];
---
<Page
  title="Charts"
  dek="Guides to Unreal on the machines people already have: how something works, how to measure it, and how to use the tools that do."
>
  <ol class="charts">
    {charts.map((c) => (
      <li>
        <a href={c.href}>
          <span class="title hull">{c.title}</span>
          <span class="tool">{c.tool}</span>
        </a>
        <p>{c.what}</p>
      </li>
    ))}
  </ol>
  <div class="prose">
    <p>
      Every chart says what you need before you start, gives every command in order with what you should see after
      it, and explains why it works, so you can adapt it when your setup differs. To write one, start with
      the <a href="/contributing/">contributing guide</a>.
    </p>
  </div>
</Page>
<style>
  .charts {
    list-style: none;
    margin: 0 0 var(--s-7);
    padding: 0;
    max-width: 52rem;
    counter-reset: chart;
  }
  .charts li {
    counter-increment: chart;
    position: relative;
    padding: var(--s-5) 0 var(--s-5) 4rem;
    border-top: 2px solid var(--rule);
  }
  .charts li:last-child {
    border-bottom: 2px solid var(--rule);
  }
  .charts li::before {
    content: counter(chart, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--accent);
    line-height: 1.6;
  }
  .charts a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem var(--s-4);
    color: var(--text);
    text-decoration: none;
  }
  .title {
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .charts a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
  }
  .tool {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--link);
  }
  .charts p {
    margin: var(--s-2) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .charts li {
      padding-left: 2.75rem;
    }
    .charts li::before {
      font-size: var(--step-0);
    }
  }
</style>
